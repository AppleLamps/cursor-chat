# No server-side Cursor API key is required for AskCursor.

# BYOK flow:
# - Users paste a Cursor API key in the browser UI.
# - The app forwards that key to /api/repos and /api/chat per request.
# - Keys are never persisted on the server.
# - Optional "remember on this device" stores the key in browser localStorage only.

# Optional "Connect GitHub" button (otherwise users paste a personal access token).
# Create a GitHub OAuth App with the callback URL
#   https://<your-host>/api/auth/github/callback
# - The client secret stays on the server and is never sent to the browser.
# - The resulting token is handed to the browser, which stores it like a pasted one.
# ASKCURSOR_GITHUB_CLIENT_ID=
# ASKCURSOR_GITHUB_CLIENT_SECRET=
# - "repo" (default) reads private repos; "public_repo" limits access to public ones.
# ASKCURSOR_GITHUB_OAUTH_SCOPE=repo

# Optional local overrides (usually not needed):
# NODE_ENV=development

# Production request controls:
# - REQUIRED in production. These back rate limits and the active chat stream cap.
# - Local development falls back to in-memory counters when these are omitted.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# - Maximum concurrent /api/chat streams across the deployment.
# ASKCURSOR_MAX_ACTIVE_CHAT_STREAMS=50
#
# - Maximum concurrent streams one Cursor key may hold, so a single user cannot
#   take every slot.
# ASKCURSOR_MAX_ACTIVE_STREAMS_PER_USER=3
#
# - Header your proxy sets to the real client IP. Only set this when the header
#   cannot be forged by clients (it is read in place of x-forwarded-for).
# ASKCURSOR_TRUSTED_IP_HEADER=x-real-ip

# Implement mode guardrails:
# - Set to "false" to disable all write-capable Cursor agent runs.
# ASKCURSOR_ENABLE_IMPLEMENT_MODE=true
#
# - REQUIRED in production so agent resume tokens survive deploys/restarts.
#   Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ASKCURSOR_AGENT_SESSION_SECRET=
#
# - Optional comma-separated allowlists. Values support "*" wildcards.
#   Repos can be full URLs or "owner/repo" slugs.
# ASKCURSOR_IMPLEMENT_ALLOWED_OWNERS=
# ASKCURSOR_IMPLEMENT_ALLOWED_REPOS=
# ASKCURSOR_IMPLEMENT_ALLOWED_BRANCHES=
#
# - Branch allowlists apply to starting refs, not write targets. Main is a
#   valid starting ref: workOnCurrentBranch is explicitly false for all creates.
#   Legacy PROTECTED_BRANCHES / ALLOW_PROTECTED_IMPLEMENT_BRANCHES settings
#   no longer block starting refs. Use ALLOWED_BRANCHES to restrict origins.
